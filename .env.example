# Variáveis de ambiente necessárias (configurar em: Zeabur > seu projeto >
# aba Variables — ou no VPS Hetzner no .env / systemd / pm2).
# São as MESMAS credenciais que já estão na Vercel quando usa espelho.

PORT=8080

# Key da TMDB (https://www.themoviedb.org/settings/api)
# Usada pelo proxy em /api/tmdb.js — nunca é exposta no client.
TMDB_API_KEY=

# Service role key do Supabase (Project Settings > API > service_role)
# Usada por quase todos os endpoints: admin-vip, embed-config, redeem-vip,
# vip-status, track-login, comments, active-ads, iptv-sync, subtitles, live-tv.
# NUNCA exponha esta key no client.
SUPABASE_SERVICE_ROLE_KEY=

# URL do projeto Supabase (opcional — tem default no código).
# SUPABASE_URL=https://gkujbjpvphuvrejpvvtz.supabase.co

# Anon key do Supabase — usada só para validar JWT do usuário em lib/vip-gate.js
# (GET /auth/v1/user). Pode ser a mesma anon key pública do app.
# SUPABASE_ANON_KEY=

# ── Gate VIP no servidor (Live TV) ──────────────────────────────────────
# 0 ou ausente = soft (NÃO bloqueia; app atual continua normal).
# 1 = hard: /api/live-tv só devolve canais se houver VIP válido
#     (Authorization: Bearer <jwt> OU ?userId= com vip_status ativo
#      OU ?deviceId= com tv_activations ativo).
# Ative DEPOIS de publicar app que envia o token no header.
# REQUIRE_VIP_LIVE_TV=0

# Key gratuita da OMDb (https://www.omdbapi.com/apikey.aspx — plano "Free",
# 1.000 requisições/dia). Se não configurada, o site funciona normal e só
# não mostra as notas extras do IMDb/Rotten Tomatoes.
OMDB_API_KEY=

# Credenciais da OpenSubtitles (https://www.opensubtitles.com) usadas por
# /api/subtitles.js (busca e download de legendas em pt-BR).
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Segredo usado para autorizar a chamada do cron job de sincronização IPTV
# (/api/iptv-sync.js) quando disparado externamente (ex: cron-job.org),
# já que o Zeabur não tem "Vercel Cron" nativo — ver README.md pra como
# configurar um agendador externo que chame essa rota diariamente.
CRON_SECRET=
