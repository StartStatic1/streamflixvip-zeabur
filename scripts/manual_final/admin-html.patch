+    document.getElementById('manualGroupInput').value='Manuais'; loadLiveTvManuals();
+  }
+  function editManualChannel(id) {
+    const c = _allManualChannels.find(x=>x.id===id); if(!c) return;
+    document.getElementById('manualNameInput').value=c.name||'';
