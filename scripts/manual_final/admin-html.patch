+    document.getElementById('manualLogoInput').value=c.logo||'';
+    document.getElementById('manualGroupInput').value=c.group_title||'Manuais';
+    document.getElementById('manualPriorityInput').value=c.priority??1;
+    const btn=document.getElementById('saveManualBtn'); btn.dataset.editingId=id; btn.textContent='Salvar alterações';
+  }
