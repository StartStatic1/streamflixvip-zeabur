+  let _allManualChannels = [];
+  async function loadLiveTvManuals() {
+    const data = await api('list-live-tv-manual');
+    if (data.error) {
+      const wrap = document.getElementById('manualListWrap');
+      if (wrap) wrap.innerHTML = `<p style="color:#f59e0b;padding:16px">⚠️ ${escapeHtml(String(data.error.message||data.error))}</p>`;
+      return;
+    }
+    _allManualChannels = data.channels || [];
+    const wrap = document.getElementById('manualListWrap');
+    if (!_allManualChannels.length) { wrap.innerHTML = '<p style="color:var(--muted);padding:20px;text-align:center">Nenhum canal manual.</p>'; return; }
+    wrap.innerHTML = `<table><thead><tr><th>Nome</th><th>Grupo</th><th>URL</th><th>Pri</th><th></th></tr></thead><tbody>${_allManualChannels.map(c=>`<tr><td>${escapeHtml(c.name)}</td><td>${escapeHtml(c.group_title||'')}</td><td style="font-size:0.7rem;max-width:160px;overflow:hidden;text-overflow:ellipsis">${escapeHtml(c.stream_url||'')}</td><td>${c.priority??'—'}</td><td><button class="btn-secondary" style="width:auto;padding:6px 10px;font-size:0.75rem" onclick="editManualChannel('${c.id}')">✏️</button> <button class="btn-secondary" style="width:auto;padding:6px 10px;font-size:0.75rem" onclick="toggleManualChannel('${c.id}',${!c.is_active})">${c.is_active?'⏸️':'▶️'}</button> <button class="btn-secondary" style="width:auto;padding:6px 10px;font-size:0.75rem" onclick="deleteManualChannel('${c.id}','${escapeHtml(c.name).replace(/'/g,"\\'")}')">🗑️</button></td></tr>`).join('')}</tbody></table>`;
+  }
+  async function saveManualChannel() {
+    const name = document.getElementById('manualNameInput').value.trim();
+    const streamUrl = document.getElementById('manualUrlInput').value.trim();
+    const logo = document.getElementById('manualLogoInput').value.trim();
+    const groupTitle = document.getElementById('manualGroupInput').value.trim() || 'Manuais';
+    const priority = parseInt(document.getElementById('manualPriorityInput').value,10)||1;
+    const raw = document.getElementById('manualRawInput').value.trim();
+    const btn = document.getElementById('saveManualBtn');
+    const editingId = btn.dataset.editingId || '';
+    if (!editingId && !streamUrl && !raw) { showToast('Informe URL ou M3U'); return; }
+    btn.disabled = true;
+    const result = editingId
+      ? await api('update-live-tv-manual', { channelId: editingId, name, streamUrl, logo, groupTitle, priority })
+      : await api('create-live-tv-manual', { name, streamUrl, logo, groupTitle, priority, raw });
+    btn.disabled = false; delete btn.dataset.editingId; btn.textContent = 'Salvar canal manual';
+    if (result.error) { showToast('❌ '+(result.error.message||result.error)); return; }
