<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Mesmo fix aplicado no app de celular (ver android/.../network_security_config.xml):
        permite tráfego HTTP puro pra provedores IPTV que servem listas
        m3u8/mp4 sem certificado. Sem isso, o ExoPlayer recusa tocar com
        ERROR_CODE_IO_CLEARTEXT_NOT_PERMITTED, mesmo com o Manifest
        pedindo usesCleartextTraffic="true" (o Android exige esse arquivo
        em separado a partir da API 28+).
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
