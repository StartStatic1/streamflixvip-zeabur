<?xml version="1.0" encoding="utf-8"?>
<!-- Banner 320x180 exigido pelo launcher de TV. Fundo escuro + disco cyan + play. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#05050A" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <!-- Disco ciano centralizado (aprox.) -->
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00E5FF" />
        </shape>
    </item>
</layer-list>
