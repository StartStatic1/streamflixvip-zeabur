<?xml version="1.0" encoding="utf-8"?>
<!-- Banner mínimo 320x180dp exigido pelo launcher de TV (android:banner
     no Manifest). Fundo escuro + texto dourado, provisório até você
     substituir por uma arte de verdade. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A0A10" />
        </shape>
    </item>
</layer-list>
