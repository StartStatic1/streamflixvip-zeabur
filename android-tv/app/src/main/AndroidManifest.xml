<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Declara suporte a controle remoto (D-pad) em vez de touchscreen —
         sem isso, a Play Store e alguns launchers de TV podem nem listar
         o app como compatível com Android TV. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".StreamFlixTvApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="StreamFlixVIP TV"
        android:theme="@style/Theme.StreamFlixVIP.TV"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainTvActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.StreamFlixVIP.TV"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER (não LAUNCHER comum) é o que faz o
                     app aparecer na tela inicial de apps de TV (Fire TV,
                     Android TV) em vez de só em "todos os apps". -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
