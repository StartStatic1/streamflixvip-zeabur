<resources>
    <!-- Tema base mínimo — a UI real é toda definida em Compose
         (ui/theme/Theme.kt). Este XML só existe porque o Android exige
         um tema referenciado no Manifest antes da Activity montar o
         Compose. -->
    <style name="Theme.StreamFlixVIP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#0A0A10</item>
        <item name="android:navigationBarColor">#0A0A10</item>
        <item name="android:windowBackground">#0A0A10</item>
    </style>

    <!-- Tema de Splash Screen nativo (aparece ANTES do Compose renderizar) -->
    <style name="Theme.StreamFlixVIP.Splash" parent="Theme.StreamFlixVIP">
        <item name="android:windowBackground">#0A0A10</item>
    </style>
</resources>
