# Keystores — NUNCA versionar. A keystore de debug/release é recriada
# a cada build do GitHub Actions a partir do Secret DEBUG_KEYSTORE_BASE64
# (ver .github/workflows/build-android-apk.yml). Se um arquivo .keystore
# for commitado aqui por engano, considere a chave comprometida e gere
# uma nova (o que exige reinstalar o app em todos os aparelhos).
*.keystore
*.jks

# Build outputs — gerados a cada build, não fazem sentido versionados.
/build/
/app/build/
/*/build/

# Arquivos locais do Gradle/Android Studio
local.properties
.gradle/
.idea/
*.iml
captures/
.cxx/
